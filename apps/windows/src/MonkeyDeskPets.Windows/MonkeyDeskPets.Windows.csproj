<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.17763.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <!--
      WPF 與 Windows Forms 同時啟用時，SDK 的隱含 using 會匯入兩套 UI
      命名空間，造成 Image、Button、Point、Brushes 等型別名稱衝突。
      改由 GlobalUsings.cs 僅匯入不衝突的基礎命名空間。
    -->
    <ImplicitUsings>disable</ImplicitUsings>
    <ApplicationIcon>Assets\MonkeyDeskPets.ico</ApplicationIcon>
    <AssemblyName>MonkeyDeskPets</AssemblyName>
    <RootNamespace>MonkeyDeskPets.Windows</RootNamespace>
    <Version>0.3.3</Version>
    <Authors>廷廷小教室、廷廷的家（Tim945）</Authors>
    <Copyright>Copyright © 2026 廷廷小教室、廷廷的家（Tim945）</Copyright>
  </PropertyGroup>

  <ItemGroup>
    <None Update="Assets\MonkeyDeskPets.ico"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\..\..\shared\assets\person-sprites.png"
             Link="Assets\person-sprites.png"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
    <!--
      Keep an assembly-embedded fallback so Restore Default Sprites and initial
      startup still work if an external package is accidentally incomplete.
    -->
    <EmbeddedResource Include="..\..\..\..\shared\assets\person-sprites.png"
                      LogicalName="MonkeyDeskPets.DefaultSprites.png" />
    <Content Include="..\..\..\..\shared\assets\author-avatar.png"
             Link="Assets\author-avatar.png"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\..\..\shared\assets\logitech-ad.jpeg"
             Link="Assets\logitech-ad.jpeg"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\..\..\LICENSE"
             Link="Licenses\LICENSE.txt"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\..\..\NOTICE"
             Link="Licenses\NOTICE.txt"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\..\..\ADDITIONAL-TERMS-zh-TW.txt"
             Link="Licenses\ADDITIONAL-TERMS-zh-TW.txt"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\..\..\ADDITIONAL-TERMS-en.txt"
             Link="Licenses\ADDITIONAL-TERMS-en.txt"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\..\..\POLYFORM-NONCOMMERCIAL-1.0.0.txt"
             Link="Licenses\POLYFORM-NONCOMMERCIAL-1.0.0.txt"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
